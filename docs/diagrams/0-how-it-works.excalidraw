   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Our own model: Pulse-LM (experimental)",
   "originalText": "Our own model: Pulse-LM (experimental)",
   "fontSize": 26,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "te78",
   "type": "text",
   "x": 998,
   "y": 855.25,
   "width": 844,
   "height": 90.0,
   "angle": 0,
   "strokeColor": "#5c5c5c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "g76"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 1322752333,
   "version": 1,
   "versionNonce": 596120394,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2022  Gemini (the teacher) wrote 450 example plans; our critic kept the best 137.\n\u2022  We fine-tuned Qwen3-4B with LoRA on a free Colab GPU.\n\u2022  It runs in Ollama on the render computer: no paid API.\n\u2022  Plans the script and shots in one call. Scores 6.6 vs Gemini 7.41.",
   "originalText": "\u2022  Gemini (the teacher) wrote 450 example plans; our critic kept the best 137.\n\u2022  We fine-tuned Qwen3-4B with LoRA on a free Colab GPU.\n\u2022  It runs in Ollama on the render computer: no paid API.\n\u2022  Plans the script and shots in one call. Scores 6.6 vs Gemini 7.41.",
   "fontSize": 18,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "te79",
   "type": "text",
   "x": 60,
   "y": 1030,
   "width": 1524.6000000000001,
   "height": 22.5,
   "angle": 0,
   "strokeColor": "#5c5c5c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1185332842,
   "version": 1,
   "versionNonce": 598335251,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Runs with our laptop off, on free tiers:  Vercel (website)  \u00b7  GitHub Actions (one computer per video)  \u00b7  Supabase (data, videos, login)  \u00b7  \u20b90 per video",
   "originalText": "Runs with our laptop off, on free tiers:  Vercel (website)  \u00b7  GitHub Actions (one computer per video)  \u00b7  Supabase (data, videos, login)  \u00b7  \u20b90 per video",
   "fontSize": 18,
   "fontFamily": 6,
   "textAlign": "left",
