   ],
   "frameId": null,
   "roundness": null,
   "seed": 1570775963,
   "version": 1,
   "versionNonce": 660744637,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "\u2022  Every AI answer is strict JSON, checked by code (zod). Broken? Ask again with the error.\n\u2022  Backup models: Gemini 3.5 Flash \u2192 3.x Flash-Lite \u2192 Gemma 4. Busy or out of quota? Next one.\n\u2022  The AI advises, code decides: length, readable text, loudness.\n\u2022  Every step and its reason is saved, so you watch it happen live.",
   "originalText": "\u2022  Every AI answer is strict JSON, checked by code (zod). Broken? Ask again with the error.\n\u2022  Backup models: Gemini 3.5 Flash \u2192 3.x Flash-Lite \u2192 Gemma 4. Busy or out of quota? Next one.\n\u2022  The AI advises, code decides: length, readable text, loudness.\n\u2022  Every step and its reason is saved, so you watch it happen live.",
   "fontSize": 18,
   "fontFamily": 6,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "autoResize": true,
   "lineHeight": 1.25
  },
